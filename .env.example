# Kompyuterda tunnel ishlatsangiz ALLOWED_HOSTS=* qiling
ALLOWED_HOSTS=bot.example.uz
# Bot tokenlari/to'lov kalitlarini shifrlash kaliti. Yaratish:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# MUHIM: yo'qotsangiz bazadagi tokenlarni qayta kiritishga to'g'ri keladi.
